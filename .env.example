APP_NAME="PhoeniTech Management"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=phoenitech_sales
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:8000
SANCTUM_EXPIRATION=10080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,https://sales.phoenitech.sy

# Audit trail — who changed what, when. Retention is enforced by the weekly
# `audit:prune` schedule; 0 keeps entries forever.
AUDIT_ENABLED=true
AUDIT_RETENTION_DAYS=365

# Attendance. The app runs on UTC; this is the timezone a check-in is dated and
# measured in, so a late-evening check-in is not filed under the next day.
# WEEK_START is display order only (0=Sunday … 6=Saturday) — the actual working
# week is per employee, defined by their schedule's days.
ATTENDANCE_TIMEZONE=Asia/Damascus
ATTENDANCE_WEEK_START=6
ATTENDANCE_ALLOW_DAY_OFF_CHECK_IN=true
ATTENDANCE_AUTO_CHECKOUT=false

# Telegram. Off until a bot token and a chat id are set: the app never reaches
# out to Telegram without both. `chat_id` is the management group the bot posts
# into — a group id is negative. `php artisan telegram:check --updates` prints
# the ids of the chats the bot can see; `--send` posts a test message.
#
# TELEGRAM_PROXY is only needed where the network cannot open a connection to
# api.telegram.org, and takes any URL Guzzle accepts (http:// or socks5://).
# TELEGRAM_QUEUE stays false until a queue worker is running; false sends the
# message after the response instead, which needs no worker.
TELEGRAM_NOTIFICATIONS_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_PROXY=
TELEGRAM_TIMEOUT=5
TELEGRAM_QUEUE=false
TELEGRAM_NOTIFY_CHECK_IN=true
TELEGRAM_NOTIFY_CHECK_OUT=true
TELEGRAM_NOTIFY_LEAVE_REQUEST=true
